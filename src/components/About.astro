---
const stats = [
	{ value: "3+", label: "Years Shipping Production Vue" },
	{ value: "13", label: "Live, Deployed Projects" },
	{ value: "2,000", label: "Seeded Cases Validated Per Run" },
];

const techGroups = [
	{
		category: "Languages",
		items: ["TypeScript", "JavaScript", "Rust", "Python"],
	},
	{
		category: "Front-End",
		items: ["React", "Vue", "Next.js", "Nuxt", "Astro", "TanStack Start", "Tailwind CSS"],
	},
	{
		category: "Real-Time & Multiplayer",
		items: ["WebSockets", "Colyseus", "PartyKit", "Socket.io", "Convex"],
	},
	{
		category: "Simulation & Graphics",
		items: ["Three.js", "React Three Fiber", "Phaser", "Web Audio API"],
	},
	{
		category: "Desktop & Data",
		items: ["Tauri", "SQLite", "Drizzle ORM", "Neon", "Supabase", "Cloudflare Workers"],
	},
	{
		category: "Testing & Tooling",
		items: ["Vitest", "Playwright", "Cypress", "Vite", "Git"],
	},
];
---

<section class="about" id="about">
	<div class="about-inner">
		<div class="section-label reveal">
			<span class="label-line"></span>
			<span class="label-text">About</span>
		</div>

		<div class="about-grid">
			<div class="about-text">
				<h2 class="reveal reveal-delay-1">An engineer who cares about<br /><span class="text-accent">what holds up.</span></h2>
				<p class="reveal reveal-delay-2">
					Software engineer with a 5-year engineering degree, based in Casablanca, Morocco.
					Most of what I build is systems work: deterministic simulation engines, authoritative multiplayer
					servers, procedural generators, and local-first desktop apps in Rust and Tauri. I care about the
					parts that are hard to see — replayable state, invariants that hold over months of simulated time,
					and persistence that migrates old saves forward instead of dropping them.
				</p>
				<p class="reveal reveal-delay-3">
					Alongside that, I've spent three years shipping production Vue for enterprise clients at Forvis
					Mazars, leading frontend work and introducing testing across the codebase. The interface half
					matters to me too — accessibility, motion, and detail — it just isn't the whole of what I do.
				</p>
			</div>

			<div class="about-stats reveal reveal-delay-2">
				{stats.map((stat) => (
					<div class="stat">
						<span class="stat-value">{stat.value}</span>
						<span class="stat-label">{stat.label}</span>
					</div>
				))}
			</div>
		</div>

		<div class="tech-stack reveal">
			<h3 class="tech-title">Tech I work with</h3>
			<div class="tech-groups">
				{techGroups.map((group) => (
					<div class="tech-group">
						<span class="tech-category">{group.category}</span>
						<div class="tech-items">
							{group.items.map((item) => (
								<span class="tech-item">{item}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.about {
		padding: 8rem 2rem;
		border-top: 1px solid var(--border);
	}

	.about-inner {
		max-width: 1000px;
		margin: 0 auto;
	}

	.section-label {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.label-line {
		width: 40px;
		height: 1px;
		background: var(--accent);
	}

	.label-text {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 4rem;
		align-items: start;
		margin-bottom: 5rem;
	}

	.about-text h2 {
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
	}

	.text-accent {
		color: var(--accent);
	}

	.about-text p {
		font-size: 1rem;
		line-height: 1.8;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.about-stats {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-left: 2rem;
		border-left: 1px solid var(--border);
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.stat-value {
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.tech-stack {
		padding: 2.5rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 16px;
	}

	.tech-title {
		font-size: 0.85rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 2rem;
	}

	.tech-groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2rem;
	}

	.tech-category {
		display: block;
		font-size: 0.75rem;
		color: var(--accent);
		font-family: var(--font-mono);
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.tech-items {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tech-item {
		font-size: 0.85rem;
		color: var(--text-muted);
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		transition: all 0.2s;
	}

	.tech-item:hover {
		border-color: var(--accent);
		color: var(--text);
		background: var(--accent-glow);
	}

	@media (max-width: 768px) {
		.about {
			padding: 5rem 1.25rem;
		}

		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.about-stats {
			flex-direction: row;
			flex-wrap: wrap;
			border-left: none;
			border-top: 1px solid var(--border);
			padding-left: 0;
			padding-top: 2rem;
			gap: 1.5rem;
		}

		.stat {
			flex: 1 1 8rem;
		}

		.tech-stack {
			padding: 1.5rem;
		}

		/*
		 * The authored line break is tuned for the desktop measure; on a phone
		 * it produces a too-long first line. Let the text wrap on its own.
		 */
		.about-text h2 br {
			display: none;
		}
	}

	@media (max-width: 420px) {
		.stat-value {
			font-size: 2rem;
		}

		.stat-label {
			font-size: 0.72rem;
		}
	}
</style>
