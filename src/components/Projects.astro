		github: "https://github.com/AyoubSen/Store-templater",
		liveUrl: "https://store-templater.vercel.app/",
		screenshots: ["/projects/store-templater/landing.jpg"],
		featured: true,
		number: "03",
	},
	{
		id: "workbench",
		title: "Workbench",
