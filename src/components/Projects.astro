---
const projects = [
	{
		id: "reeldex",
		title: "Reeldex",
		description: "Swipe-based tool for rebuilding your entire watch history, with a recognition-first ranking engine and a calibration round that fits the deck to your taste.",
		longDescription: "Reeldex helps people reconstruct everything they've ever watched by swiping through a deck ordered for recognisability rather than raw popularity. A short calibration round fits a viewer model across era and market axes, and a deterministic two-stage ranking engine scores each title then interleaves the deck so it never repeats the same genre, decade, language, director, or franchise back to back. The catalogue is powered by TMDB behind a provider abstraction, with a bundled demo set for offline use, and everything persists locally with schema-versioned storage, JSON export/import, and a visible warning if saving ever breaks.",
		tags: ["React", "TypeScript", "Vite", "TMDB API", "Framer Motion", "Tailwind CSS"],
		github: "https://github.com/AyoubSen/recall",
		liveUrl: "https://reeldex.vercel.app/",
		screenshots: ["/projects/reeldex/deck.jpg", "/projects/reeldex/library.jpg", "/projects/reeldex/for-you.jpg"],
		featured: true,
		number: "01",
	},
