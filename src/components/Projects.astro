		id: "evileggs",
		title: "EvilEggs",
		description: "Original browser artillery game with destructible terrain, 15 weapons, and real-time local or online 1v1/2v2/3v3 matches.",
		longDescription: "An original turn-based artillery game built with React, Vite, and Phaser, featuring destructible terrain, timed turns, drag-to-aim mechanics, and a fifteen-weapon arsenal. Players battle in local hot-seat matches or private online rooms for 1v1, 2v2, and 3v3 play, powered by a Colyseus-based authoritative server running a deterministic fixed-tick simulation. Optional Clerk accounts and Neon-backed persistence unlock cloud-synced character customization and outfit presets, while guest play remains fully available without sign-in.",
		tags: ["React", "Phaser", "Colyseus", "TypeScript", "Clerk", "Neon"],
		github: "https://github.com/AyoubSen/tsw-evileggs",
		liveUrl: "https://evileggs.vercel.app/",
		screenshots: ["/projects/evileggs/landing.jpg", "/projects/evileggs/gameplay.jpg"],
		featured: true,
		number: "02",
	},
